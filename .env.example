# PostgreSQL connection string
# Local example (Homebrew / local Postgres):
# DATABASE_URL="postgresql://USER@localhost:5432/rankiq?schema=public"
#
# Vercel / hosted example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=public"

DATABASE_URL="postgresql://USER@localhost:5432/rankiq?schema=public"

# Fail production startup/build when VERCEL_ENV=production (automatic on Vercel)
# or set explicitly for staging:
# RANKIQ_STRICT_ENV=1

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# App URL used for magic-link callbacks (canonical public URL in production)
# Production: https://rankeyeq.com
# Local:  http://localhost:3000
AUTH_URL="http://localhost:3000"

# On Vercel, Auth.js can also trust the host header:
# AUTH_TRUST_HOST=true

# Email magic link
# Option A — Resend (recommended for Vercel)
# AUTH_RESEND_KEY="re_..."
# EMAIL_FROM="RankEYEQ <noreply@rankeyeq.com>"
#
# Option B — SMTP via Nodemailer
# EMAIL_SERVER="smtps://USER:PASSWORD@smtp.example.com:465"
# EMAIL_FROM="RankEYEQ <noreply@rankeyeq.com>"
#
# Local without email: magic links are printed to the server console.

# Google OAuth (optional)
# Create OAuth client in Google Cloud Console.
# Authorized redirect URI:
#   Local:  http://localhost:3000/api/auth/callback/google
#   Vercel: https://YOUR_PROJECT.vercel.app/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Seeded admin account (magic-link sign-in). No password stored.
SEED_ADMIN_EMAIL="admin@rankiq.local"

# Support / legal contact (optional — used in policy pages)
# SUPPORT_EMAIL="support@example.com"
# LEGAL_CONTACT_EMAIL="legal@example.com"

# SNG LABS company website (optional — footer attribution link)
# SNG_LABS_URL="https://snglabs.com"

# Optional local debug chrome (never enable in production)
# RANKIQ_DEV_PROFILE_SWITCHER=1

# Dev fallback: unlock PREMIUM_REVEAL boards during Sunday 10am–noon CT.
# Persistent BoardEntitlement records are the source of truth; this flag is optional.
# RANKIQ_BOARD_REVEAL_ENTITLED=1

# All consensus composition: group_weighted (default) | ballot_union
# RANKEYEQ_CONSENSUS_ALL_MODE="group_weighted"

# ---------------------------------------------------------------------------
# NFL data provider (schedule / player pools — not grading)
# ---------------------------------------------------------------------------
# manual | mock (default) | sportsdataio
# Production without a paid sports-data API: NFL_DATA_PROVIDER=manual
NFL_DATA_PROVIDER="manual"

# SportsDataIO (only used when NFL_DATA_PROVIDER=sportsdataio)
# SPORTSDATAIO_API_KEY=""
# Optional override (default: https://api.sportsdata.io/v3/nfl/scores/json)
# SPORTSDATAIO_BASE_URL="https://api.sportsdata.io/v3/nfl/scores/json"
