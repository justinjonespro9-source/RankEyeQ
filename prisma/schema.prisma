// RankIQ persistent data model
// Identity is universal-profile-ready; RankIQ contests reference UniversalProfile.

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ProfileType {
  HUMAN
  AI
  BENCHMARK
  /// Content-creator competitor class (distinct from monetization CreatorProfile).
  CREATOR
}

enum BenchmarkCaptureType {
  THURSDAY
  SUNDAY
  MANUAL_FINAL
}

enum BenchmarkSnapshotStatus {
  DRAFT
  CAPTURED
  LOCKED
  GRADED
  NOT_AVAILABLE
  LATE
}

enum UserRole {
  USER
  ADMIN
}

enum ProfileStatus {
  ACTIVE
  SUSPENDED
}

enum WeekStatus {
  UPCOMING
  OPEN
  LOCKED
  COMPLETE
  ARCHIVED
}

enum ContestPosition {
  QB
  RB
  WR
  TE
  DEF
}

enum ContestStatus {
  DRAFT
  OPEN
  LOCKED
  LIVE
  GRADING
  FINAL
  ARCHIVED
}

enum RankableEntryType {
  PLAYER
  DEFENSE
}

enum EntryAvailability {
  ACTIVE
  QUESTIONABLE
  DOUBTFUL
  OUT
  IR
  PUP
  SUSPENDED
  FREE_AGENT
  INACTIVE
}

/// Week-specific game availability (injury report / inactive list).
/// Distinct from SeasonPlayer roster membership (ACTIVE/IR/PUP/etc.).
enum WeeklyAvailabilityDesignation {
  AVAILABLE
  QUESTIONABLE
  DOUBTFUL
  OUT
  INACTIVE
  UNKNOWN
}

enum WeeklyAvailabilitySourceType {
  MANUAL
  NFL_SYNC
  IMPORT
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LOCKED
  GRADED
}

enum BoardRevealPreference {
  FREE_REVEAL
  PREMIUM_REVEAL
}

/// Who controls a profile + contest competitive board. Per submission, not per profile.
enum SubmissionAuthority {
  /// Authored through the authenticated ranking workspace by the owning HUMAN/CREATOR.
  OWNER_AUTHORED
  /// Captured by RankEyeQ from an external source (tracked Creator / BENCHMARK).
  RANKEYEQ_CAPTURED
  /// RankEyeQ-operated competitor board (AI).
  SYSTEM_OPERATED
}

/// Immutable Official RankEyeQ Board version kinds. Presentation + history only.
enum OfficialBoardVersionKind {
  /// Owner explicitly published (or updated) the board before full lock.
  PUBLISHED
  /// What competed: captured once at full lock (or the pre-grade backstop).
  FINAL
}

enum WeeklyContentType {
  VIDEO
  ARTICLE
  PODCAST
  RANKINGS
  OTHER
}

enum EntitlementType {
  SINGLE_BOARD
  CREATOR_WEEK
  POSITION_WEEK
  WEEK_ALL_ACCESS
  SUBSCRIPTION
}

enum UnlockAccessType {
  FREE_REVEAL
  PREMIUM_ENTITLEMENT
  PUBLIC_AFTER_RELEASE
  OWNER
  ADMIN
}

enum LedgerEntryType {
  TEST
  BOARD_UNLOCK
  SUBSCRIPTION
  ADJUSTMENT
}

enum LedgerEntryStatus {
  PENDING
  EARNED
  PAYABLE
  PAID
  REVERSED
}

enum NflGameStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
  POSTPONED
  CANCELED
  OTHER
}

enum ScoringVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// Manual Creator claim / verification state on CreatorCompetitorProfile.
/// Tracked (imported) creators stay UNCLAIMED until a real person is approved.
enum CreatorClaimStatus {
  UNCLAIMED
  REQUESTED
  VERIFIED
  REJECTED
}

/// Generalized ownership claim for tracked BENCHMARK (Expert) or CREATOR profiles.
/// Distinct from CreatorCompetitorProfile in-place HUMAN→CREATOR promotion.
enum ProfileClaimStatus {
  REQUESTED
  APPROVED
  REJECTED
}

model UniversalProfile {
  id              String        @id @default(cuid())
  /// Future cross-platform Handicap Hero / FantasyTrack mapping key.
  universalUserId String?       @unique
  username        String        @unique
  displayName     String
  avatarUrl       String?
  bio             String?
  /// Owner-controlled short title (e.g. "Fantasy Football Analyst").
  headline        String?
  /// Owner-controlled affiliation / organization display string.
  affiliation     String?
  websiteUrl      String?
  xUrl            String?
  youtubeUrl      String?
  instagramUrl    String?
  tiktokUrl       String?
  podcastUrl      String?
  featuredLinkTitle String?
  featuredLinkUrl   String?
  /// Set when Admin approves ownership claim (Expert or Creator link).
  ownershipVerifiedAt DateTime?
  /// When false, profile page returns not-found for non-owners/admins.
  publicVisible   Boolean       @default(true)
  profileType     ProfileType   @default(HUMAN)
  status          ProfileStatus @default(ACTIVE)
  /// When false, AI/BENCHMARK/CREATOR profiles are excluded from active competitor roster / coverage.
  /// Humans ignore this flag. Prefer this over SUSPENDED for retired bots/sources.
  competitorActive Boolean      @default(true)
  /// When publicVisible=true, optional gate: only weeks on/after this week are public.
  /// null = full public history (or not publicly authorized).
  publicFromWeekId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  submissions RankingSubmission[]
  benchmarkSnapshots BenchmarkSnapshot[]
  /// Auth.js account linked to this sports identity (humans only).
  authUser    User?
  followsGiven     ProfileFollow[]      @relation("FollowsGiven")
  followsReceived  ProfileFollow[]      @relation("FollowsReceived")
  creatorProfile   CreatorProfile?
  creatorCompetitor CreatorCompetitorProfile?
  /// Incoming claim requests that name this profile as the tracked creator to claim.
  creatorClaimTargets CreatorCompetitorProfile[] @relation("CreatorClaimTarget")
  /// Generalized Expert/Creator ownership claim requests naming this profile.
  profileClaimTargets ProfileClaimRequest[] @relation("ProfileClaimTarget")
  profileClaimsFiled  ProfileClaimRequest[] @relation("ProfileClaimClaimant")
  entitlementsViewed BoardEntitlement[] @relation("EntitlementViewer")
  entitlementsGranted BoardEntitlement[] @relation("EntitlementCreator")
  unlocksViewed    BoardUnlockEvent[]   @relation("UnlockViewer")
  unlocksReceived  BoardUnlockEvent[]   @relation("UnlockCreator")
  ledgerAsCreator  CreatorLedgerEntry[] @relation("LedgerCreator")
  ledgerAsViewer   CreatorLedgerEntry[] @relation("LedgerViewer")
  expertSource     ExpertSourceProfile?
  publicFromWeek   Week?                @relation("ProfilePublicFromWeek", fields: [publicFromWeekId], references: [id], onDelete: SetNull)
  officialBoardPublications OfficialBoardPublication[]
  officialBoardVersions     OfficialBoardVersion[]
  weeklyContent             WeeklyContent[]
  waiverSubmissions         WaiverSubmission[]
  waiverAiResponses         WaiverAiResponse[]
  waiverAiHistoricalEvidence WaiverAiHistoricalEvidence[]

  @@index([publicFromWeekId])
}

/// Ownership claim: authenticated HUMAN → existing unclaimed BENCHMARK or CREATOR.
/// Does not rewrite competitive submissions on the target identity.
model ProfileClaimRequest {
  id                   String             @id @default(cuid())
  claimantUserId       String
  claimantProfileId    String
  targetProfileId      String
  status               ProfileClaimStatus @default(REQUESTED)
  creatorSiteUrl       String?
  socialHandle         String?
  socialUrl            String?
  publicProofUrl       String?
  claimNote            String?
  verificationNotes    String?
  reviewedByUserId     String?
  reviewedAt           DateTime?
  requestedAt          DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  claimantUser    User             @relation("ProfileClaimClaimantUser", fields: [claimantUserId], references: [id], onDelete: Cascade)
  claimantProfile UniversalProfile @relation("ProfileClaimClaimant", fields: [claimantProfileId], references: [id], onDelete: Cascade)
  targetProfile   UniversalProfile @relation("ProfileClaimTarget", fields: [targetProfileId], references: [id], onDelete: Cascade)
  reviewedByUser  User?            @relation("ProfileClaimReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([targetProfileId])
  @@index([claimantProfileId])
  @@index([claimantUserId])
}

/// Persistent expert / third-party ranking source identity (profileType BENCHMARK).
/// Public UI label: Expert. Graded via the same RankingSubmission path as Human/AI.
model ExpertSourceProfile {
  id                 String   @id @default(cuid())
  universalProfileId String   @unique
  /// Publisher, site, or analyst brand (e.g. "FantasyPros ECR", "Establish The Run").
  publicationName    String?
  /// Optional analyst name when the source is an individual.
  analystName        String?
  sourceUrl          String?
  /// PUBLISHER (legacy inactive shell) | ANALYST | PUBLISHER_CONSENSUS | SITE_CONSENSUS
  sourceKind         String   @default("PUBLISHER")
  /// Optional disclosed source scoring assumptions (HALF_PPR | FULL_PPR | STANDARD | TE_PREMIUM | OTHER | UNSPECIFIED).
  scoringFormat      String?
  /// Contest positions this source typically publishes (empty = all).
  positionsCovered Json?
  active             Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  universalProfile UniversalProfile @relation(fields: [universalProfileId], references: [id], onDelete: Cascade)

  @@index([active])
}

/// Persistent follow edge. Historical rows survive suspension.
model ProfileFollow {
  id                String   @id @default(cuid())
  followerProfileId String
  followedProfileId String
  createdAt         DateTime @default(now())

  follower UniversalProfile @relation("FollowsGiven", fields: [followerProfileId], references: [id], onDelete: Cascade)
  followed UniversalProfile @relation("FollowsReceived", fields: [followedProfileId], references: [id], onDelete: Cascade)

  @@unique([followerProfileId, followedProfileId])
  @@index([followedProfileId])
  @@index([followerProfileId, createdAt])
}

/// Competitive Creator ranker metadata (profileType CREATOR once verified/tracked).
/// Distinct from monetization `CreatorProfile` (HUMAN payout opt-in).
/// HUMAN profiles may hold a REQUESTED row before admin approval.
model CreatorCompetitorProfile {
  id                 String   @id @default(cuid())
  universalProfileId String   @unique
  /// Individual person (e.g. "Tyler Cohen").
  personName         String?
  /// Brand / show affiliation (e.g. "TCO Fantasy Show").
  brandName          String?
  sourceUrl          String?
  /// Contest positions this creator typically publishes (empty = all).
  positionsCovered   Json?
  /// Directory active flag (separate from weekly ballot presence).
  active             Boolean  @default(true)
  notes              String?
  /// Manual claim / verification queue state.
  claimStatus        CreatorClaimStatus @default(UNCLAIMED)
  claimRequestedAt   DateTime?
  verifiedAt         DateTime?
  verifiedByUserId   String?
  rejectedAt         DateTime?
  /// Public fantasy content / site URL from the claim form.
  creatorSiteUrl     String?
  /// Primary platform handle (e.g. @name or channel name).
  socialHandle       String?
  socialUrl          String?
  /// Public proof connecting the person to RankEyeQ (receipt, post, profile link).
  publicProofUrl     String?
  /// Optional short note from the requester.
  claimNote          String?
  /// Admin-only internal notes (rejection reason, identity resolution).
  verificationNotes  String?
  /// Optional tracked CREATOR UniversalProfile this HUMAN request wants to claim.
  claimTargetProfileId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  universalProfile UniversalProfile @relation(fields: [universalProfileId], references: [id], onDelete: Cascade)
  claimTargetProfile UniversalProfile? @relation("CreatorClaimTarget", fields: [claimTargetProfileId], references: [id], onDelete: SetNull)
  verifiedByUser   User? @relation("CreatorVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([claimStatus])
  @@index([claimTargetProfileId])
}

/// Creator opt-in + default reveal preference. Qualification is derived, not stored.
model CreatorProfile {
  id                      String                @id @default(cuid())
  universalProfileId      String                @unique
  enabled                 Boolean               @default(false)
  defaultRevealPreference BoardRevealPreference @default(FREE_REVEAL)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  universalProfile UniversalProfile @relation(fields: [universalProfileId], references: [id], onDelete: Cascade)
}

/// Persistent board-access entitlement. Dev env flag remains a fallback only.
model BoardEntitlement {
  id               String          @id @default(cuid())
  viewerProfileId  String
  entitlementType  EntitlementType
  contestId        String?
  creatorProfileId String?
  weekId           String?
  startsAt         DateTime
  expiresAt        DateTime?
  source           String
  revokedAt        DateTime?
  createdAt        DateTime        @default(now())

  viewer  UniversalProfile  @relation("EntitlementViewer", fields: [viewerProfileId], references: [id], onDelete: Cascade)
  creator UniversalProfile? @relation("EntitlementCreator", fields: [creatorProfileId], references: [id], onDelete: SetNull)
  contest RankIQContest?    @relation(fields: [contestId], references: [id], onDelete: SetNull)
  week    Week?             @relation(fields: [weekId], references: [id], onDelete: SetNull)
  unlocks BoardUnlockEvent[]
  ledger  CreatorLedgerEntry[]

  @@index([viewerProfileId, revokedAt])
  @@index([creatorProfileId])
  @@index([contestId])
  @@index([weekId])
}

/// First meaningful board unlock per viewer + creator + contest.
model BoardUnlockEvent {
  id               String           @id @default(cuid())
  viewerProfileId  String
  creatorProfileId String
  contestId        String
  entitlementId    String?
  accessType       UnlockAccessType
  createdAt        DateTime         @default(now())

  viewer      UniversalProfile  @relation("UnlockViewer", fields: [viewerProfileId], references: [id], onDelete: Cascade)
  creator     UniversalProfile  @relation("UnlockCreator", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  contest     RankIQContest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  entitlement BoardEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  @@unique([viewerProfileId, creatorProfileId, contestId])
  @@index([creatorProfileId, createdAt])
  @@index([contestId])
}

/// Non-financial creator ledger stub. No real money movement.
model CreatorLedgerEntry {
  id                 String            @id @default(cuid())
  creatorProfileId   String
  viewerProfileId    String?
  contestId          String?
  entitlementId      String?
  type               LedgerEntryType
  grossAmountMinor   Int               @default(0)
  platformFeeMinor   Int               @default(0)
  creatorAmountMinor Int               @default(0)
  currency           String            @default("USD")
  status             LedgerEntryStatus @default(PENDING)
  createdAt          DateTime          @default(now())

  creator     UniversalProfile  @relation("LedgerCreator", fields: [creatorProfileId], references: [id], onDelete: Cascade)
  viewer      UniversalProfile? @relation("LedgerViewer", fields: [viewerProfileId], references: [id], onDelete: SetNull)
  contest     RankIQContest?    @relation(fields: [contestId], references: [id], onDelete: SetNull)
  entitlement BoardEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  @@index([creatorProfileId, createdAt])
  @@index([status])
}

/// Auth.js user account — not the RankIQ sports identity.
/// Contests and scores reference UniversalProfile, never this model directly.
model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  role               UserRole  @default(USER)
  universalProfileId String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  universalProfile UniversalProfile? @relation(fields: [universalProfileId], references: [id], onDelete: SetNull)
  accounts         Account[]
  sessions         Session[]
  auditLogs        AdminAuditLog[]
  benchmarkSnapshots BenchmarkSnapshot[]
  manualImports    ManualImportLog[]
  policyAcceptances PolicyAcceptance[]
  creatorVerifications CreatorCompetitorProfile[] @relation("CreatorVerifiedBy")
  profileClaimsFiled   ProfileClaimRequest[] @relation("ProfileClaimClaimantUser")
  profileClaimsReviewed ProfileClaimRequest[] @relation("ProfileClaimReviewedBy")
  playerWeekAvailabilityUpdates PlayerWeekAvailability[] @relation("PlayerWeekAvailabilityUpdatedBy")
  officialBoardVersionsAuthored OfficialBoardVersion[]
  weeklyContentSuppressed       WeeklyContent[]            @relation("WeeklyContentSuppressedBy")
  waiverSnapshotsFrozen         WaiverSnapshot[]           @relation("WaiverSnapshotFrozenBy")
  waiverSnapshotCorrections     WaiverSnapshotCorrection[] @relation("WaiverSnapshotCorrectionOperator")
  waiverContestsOpened          WaiverContest[]            @relation("WaiverContestOpenedBy")
  waiverSubmissionsCreated      WaiverSubmission[]         @relation("WaiverSubmissionCreatedBy")
  waiverRevisionsAuthored       WaiverSubmissionRevision[] @relation("WaiverRevisionAuthor")
  waiverCanonicalArtifactsImported WaiverCanonicalArtifact[] @relation("WaiverCanonicalArtifactImportedBy")
  waiverCanonicalArtifactEvents    WaiverCanonicalArtifactEvent[] @relation("WaiverCanonicalArtifactEventOperator")
  waiverConflictResolutions        WaiverConflictResolution[]     @relation("WaiverConflictResolutionResolvedBy")
  waiverGradeRunsInitiated         WaiverGradeRun[]               @relation("WaiverGradeRunInitiatedBy")
  waiverGradeApprovals             WaiverGradeApproval[]          @relation("WaiverGradeApprovalApprovedBy")
  waiverAiResponsesImported        WaiverAiResponse[]             @relation("WaiverAiResponseImportedBy")
  waiverAiEvidenceRecorded         WaiverAiHistoricalEvidence[]   @relation("WaiverAiHistoricalEvidenceRecordedBy")
  waiverAiEvidenceReviews          WaiverAiHistoricalEvidenceReview[] @relation("WaiverAiHistoricalEvidenceReviewer")
}

/// Lightweight operator audit trail. Never store secrets or auth tokens.
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([adminUserId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Season {
  id        String   @id @default(cuid())
  year      Int
  sport     String   @default("NFL")
  active    Boolean  @default(false)
  /// Default RankEyeQ ranking formula for newly created contests in this season.
  activeRankingScoringVersionId String?
  /// Default FantasyTrack fantasy scoring ruleset for new weeks in this season.
  fantasyScoringVersion         String   @default("FANTASYTRACK_NFL_HALF_PPR_V2")
  /// Last NFL roster bootstrap source label (e.g. nfl.com 2026 roster pages).
  rosterSyncSource              String?
  rosterSyncedAt                DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeks    Week[]
  contests RankIQContest[]
  games    NflGame[]
  seasonPlayers SeasonPlayer[]
  activeRankingScoringVersion RankingScoringVersion? @relation("SeasonActiveScoringVersion", fields: [activeRankingScoringVersionId], references: [id], onDelete: SetNull)
  waiverSnapshots WaiverSnapshot[]

  @@unique([year, sport])
}

model Week {
  id                    String     @id @default(cuid())
  seasonId              String
  weekNumber            Int
  label                 String
  startsAt              DateTime
  endsAt                DateTime
  status                WeekStatus @default(UPCOMING)
  /// Official RankIQ fantasy scoring ruleset used for this week’s results.
  fantasyScoringVersion String     @default("FANTASYTRACK_NFL_HALF_PPR_V2")
  /// Sport-agnostic contest timing (NFL defaults: Tue open / Sun 10am lock / noon public).
  rankingsOpenAt        DateTime?
  fullLockAt            DateTime?
  revealStartsAt        DateTime?
  publicReleaseAt       DateTime?
  /// Historical / sandbox weeks excluded from public leaderboards and consensus.
  isTest                Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  season           Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  contests         RankIQContest[]
  games            NflGame[]
  playerWeekStats  PlayerWeekStat[]
  defenseWeekStats DefenseWeekStat[]
  entitlements     BoardEntitlement[]
  benchmarkSnapshots BenchmarkSnapshot[]
  manualImports    ManualImportLog[]
  publicFromProfiles UniversalProfile[] @relation("ProfilePublicFromWeek")
  playerWeekAvailabilities PlayerWeekAvailability[]
  weeklyContent            WeeklyContent[]
  waiverSnapshots          WaiverSnapshot[]
  waiverContests           WaiverContest[]
  waiverCanonicalArtifacts WaiverCanonicalArtifact[]
  waiverGradeRuns          WaiverGradeRun[]
  waiverGradeApprovals     WaiverGradeApproval[]
  waiverGradeAuthorityChanges WaiverGradeAuthorityChange[]
  waiverGradeAuthority     WaiverWeekGradeAuthority?
  waiverEmptyPositionResults WaiverEmptyPositionResult[]

  @@unique([seasonId, weekNumber])
}

/// Persistent NFL schedule game — shared by players/defenses for a week.
model NflGame {
  id         String        @id @default(cuid())
  provider   String
  externalId String
  seasonId   String?
  weekId     String?
  seasonYear Int
  weekNumber Int
  homeTeam   String
  awayTeam   String
  startsAt   DateTime
  status     NflGameStatus @default(SCHEDULED)
  /// When admin verifies/finalizes this game's manual live WeekStat lines (not week contest FINAL).
  statsFinalizedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  season         Season?         @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  week           Week?           @relation(fields: [weekId], references: [id], onDelete: SetNull)
  contestEntries ContestEntry[]
  /// Optional denormalized “current game” pointer on rankable entries.
  rankableEntries  RankableEntry[]
  playerWeekStats  PlayerWeekStat[]
  defenseWeekStats DefenseWeekStat[]
  waiverSnapshotEntries WaiverSnapshotEntry[]

  @@unique([provider, externalId])
  @@index([seasonYear, weekNumber])
  @@index([weekId])
}

model RankIQContest {
  id           String          @id @default(cuid())
  seasonId     String
  weekId       String
  sport        String          @default("NFL")
  position     ContestPosition
  title        String
  /// EYEQ scoring field size (Top 10 / Top 15). Unchanged by reserves.
  rankingDepth Int
  /// Ordered reserve slots required at submission time for this contest.
  /// 0 = legacy pre-reserve weeks (Week 1 boards are complete at rankingDepth).
  /// 2 = current production Human/AI boards (rankingDepth + 2).
  reserveCount Int             @default(2)
  status       ContestStatus   @default(DRAFT)
  opensAt      DateTime?
  locksAt      DateTime?
  /// Frozen ranking formula used when this contest was graded/finalized.
  rankingScoringVersionId String?
  /// Immutable config snapshot applied at grade time (survives version edits).
  rankingScoringConfig    Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  season       Season               @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  week         Week                 @relation(fields: [weekId], references: [id], onDelete: Cascade)
  rankingScoringVersion RankingScoringVersion? @relation(fields: [rankingScoringVersionId], references: [id], onDelete: SetNull)
  entries      ContestEntry[]
  submissions  RankingSubmission[]
  entitlements BoardEntitlement[]
  unlocks      BoardUnlockEvent[]
  ledgerEntries CreatorLedgerEntry[]
  benchmarkSnapshots BenchmarkSnapshot[]
  pregameSnapshot    ContestPregameSnapshot?
  officialBoardPublications OfficialBoardPublication[]
  officialBoardVersions     OfficialBoardVersion[]

  @@unique([weekId, position])
  @@index([seasonId, status])
}

/// Immutable pregame consensus + selection metrics captured at Sunday full lock.
model ContestPregameSnapshot {
  id               String   @id @default(cuid())
  contestId        String   @unique
  lockedAt         DateTime
  sampleSizeAll    Int      @default(0)
  sampleSizeHuman  Int      @default(0)
  sampleSizeAi     Int      @default(0)
  sampleSizeExpert Int      @default(0)
  sampleSizeCreator Int     @default(0)
  sampleSizePublisher Int   @default(0)
  /// ballot_union (legacy HUMAN+AI ballots) | group_weighted (equal HUMAN/ANALYST-EXPERT/CREATOR/AI groups)
  allConsensusMode String   @default("group_weighted")
  createdAt        DateTime @default(now())

  contest RankIQContest                 @relation(fields: [contestId], references: [id], onDelete: Cascade)
  entries ContestPregameSnapshotEntry[]

  @@index([lockedAt])
}

model ContestPregameSnapshotEntry {
  id                      String @id @default(cuid())
  snapshotId              String
  rankableEntryId         String
  selectionRateAll        Float  @default(0)
  averageSelectedRankAll  Float?
  selectionRateHuman      Float  @default(0)
  averageSelectedRankHuman Float?
  selectionRateAi         Float  @default(0)
  averageSelectedRankAi   Float?
  selectionRateExpert     Float  @default(0)
  averageSelectedRankExpert Float?
  selectionRateCreator    Float  @default(0)
  averageSelectedRankCreator Float?
  selectionRatePublisher  Float  @default(0)
  averageSelectedRankPublisher Float?
  /// Raw individual rankings that selected this player (not group-weighted).
  selectedCountAll        Int    @default(0)
  selectedCountHuman      Int    @default(0)
  selectedCountAi         Int    @default(0)
  selectedCountExpert     Int    @default(0)
  selectedCountCreator    Int    @default(0)
  selectedCountPublisher  Int    @default(0)
  consensusRankAll        Int?
  consensusRankHuman      Int?
  consensusRankAi         Int?
  consensusRankExpert     Int?
  consensusRankCreator    Int?
  consensusRankPublisher  Int?

  snapshot      ContestPregameSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  rankableEntry RankableEntry          @relation(fields: [rankableEntryId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, rankableEntryId])
  @@index([snapshotId, consensusRankAll])
}

/// Canonical NFL player or defense reused across weeks/contests.
/// Week-specific opponent/kickoff live on ContestEntry.game (preferred) with
/// denormalized RankableEntry fields kept for display convenience.
model RankableEntry {
  id           String            @id @default(cuid())
  provider     String            @default("mock")
  externalId   String
  type         RankableEntryType
  name         String
  shortName    String
  team         String
  /// Denormalized weekly display fields (updated by import / pool build).
  opponent     String            @default("TBD")
  position     ContestPosition
  headshotUrl  String?
  gameStartsAt DateTime?
  gameId       String?
  availability EntryAvailability @default(ACTIVE)
  active       Boolean           @default(true)
  /// Optional operator note for master-directory maintenance (not public).
  adminNotes   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  game             NflGame?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  contestEntries   ContestEntry[]
  seasonPlayers    SeasonPlayer[]
  picks            RankingPick[]
  benchmarkSnapshotPicks BenchmarkSnapshotPick[]
  pregameSnapshotEntries ContestPregameSnapshotEntry[]
  officialBoardVersionPicks OfficialBoardVersionPick[]
  playerWeekStats  PlayerWeekStat[]
  defenseWeekStats DefenseWeekStat[]
  weekAvailabilities PlayerWeekAvailability[]
  waiverSnapshotEntries     WaiverSnapshotEntry[]
  waiverSnapshotCorrections WaiverSnapshotCorrection[]
  waiverPoolResults         WaiverPoolResult[]

  @@unique([provider, externalId])
  @@index([position, team])
  @@index([provider, position])
  @@index([active, position])
}

/// Per-week game availability for a RankableEntry (injury / inactive list).
/// Roster membership lives on SeasonPlayer; do not treat ACTIVE roster as AVAILABLE.
model PlayerWeekAvailability {
  id                String                        @id @default(cuid())
  weekId            String
  rankableEntryId   String
  designation       WeeklyAvailabilityDesignation @default(UNKNOWN)
  injuryDescription String?
  /// Raw NFL.com Practice Status cell (informational only; never implies Q/D/OUT).
  practiceStatus    String?
  sourceUrl         String?
  sourcePublishedAt DateTime?
  observedAt        DateTime                      @default(now())
  sourceType        WeeklyAvailabilitySourceType  @default(MANUAL)
  manualOverride    Boolean                       @default(false)
  updatedByUserId   String?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  week          Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  rankableEntry RankableEntry @relation(fields: [rankableEntryId], references: [id], onDelete: Cascade)
  updatedByUser User?         @relation("PlayerWeekAvailabilityUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([weekId, rankableEntryId])
  @@index([weekId, designation])
  @@index([rankableEntryId])
}

/// Normalized offensive player weekly fantasy stat line (audit + recompute).
model PlayerWeekStat {
  id                 String   @id @default(cuid())
  provider           String
  weekId             String
  rankableEntryId    String?
  gameId             String?
  externalPlayerId   String
  scoringVersion     String
  passingYards       Float    @default(0)
  passingTds         Int      @default(0)
  interceptions      Int      @default(0)
  rushingYards       Float    @default(0)
  rushingTds         Int      @default(0)
  receptions         Int      @default(0)
  receivingYards     Float    @default(0)
  receivingTds       Int      @default(0)
  twoPointConversions Int     @default(0)
  fumblesLost        Int      @default(0)
  /// Offensive player defensive/special-teams TDs when provided.
  returnTds          Int      @default(0)
  fantasyPoints      Float
  /// League-wide positional finish for this week (all scored NFL players at position).
  leagueActualRank   Int?
  /// True while the related game is not FINAL.
  isProvisional      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  week          Week           @relation(fields: [weekId], references: [id], onDelete: Cascade)
  rankableEntry RankableEntry? @relation(fields: [rankableEntryId], references: [id], onDelete: SetNull)
  game          NflGame?       @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([provider, weekId, externalPlayerId])
  @@index([weekId, fantasyPoints])
  @@index([weekId, leagueActualRank])
  @@index([rankableEntryId])
}

/// Normalized D/ST weekly fantasy stat line.
model DefenseWeekStat {
  id                String   @id @default(cuid())
  provider          String
  weekId            String
  rankableEntryId   String?
  gameId            String?
  team              String
  externalId        String
  scoringVersion    String
  sacks             Float    @default(0)
  interceptions     Int      @default(0)
  fumbleRecoveries  Int      @default(0)
  defensiveTds      Int      @default(0)
  specialTeamsTds   Int      @default(0)
  safeties          Int      @default(0)
  blockedKicks      Int      @default(0)
  pointsAllowed     Int      @default(0)
  fantasyPoints     Float
  /// League-wide DEF finish for this week (all scored D/ST units).
  leagueActualRank  Int?
  isProvisional     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  week          Week           @relation(fields: [weekId], references: [id], onDelete: Cascade)
  rankableEntry RankableEntry? @relation(fields: [rankableEntryId], references: [id], onDelete: SetNull)
  game          NflGame?       @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([provider, weekId, team])
  @@index([weekId, fantasyPoints])
  @@index([weekId, leagueActualRank])
  @@index([rankableEntryId])
}

/// Season-long NFL player roster entry (persistent identity for a season).
/// Distinct from weekly ContestEntry activation.
model SeasonPlayer {
  id                String          @id @default(cuid())
  seasonId          String
  rankableEntryId   String
  firstName         String?
  lastName          String?
  displayName       String
  team              String
  position          ContestPosition
  /// ACTIVE, IR, PUP, etc. — operator-maintained.
  nflStatus         String          @default("ACTIVE")
  activeOnNFLRoster Boolean         @default(true)
  /// Raw NFL.com position when it differs from RankEyeQ fantasy position (e.g. FB).
  sourcePosition    String?
  /// Raw NFL.com roster status code (ACT, CUT, RES, etc.).
  sourceNflStatus   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  season        Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  rankableEntry RankableEntry @relation(fields: [rankableEntryId], references: [id], onDelete: Restrict)

  @@unique([seasonId, rankableEntryId])
  @@index([seasonId, position, team])
  @@index([rankableEntryId])
}

/// Join: which RankableEntry is eligible for a given contest (+ optional results).
model ContestEntry {
  id              String   @id @default(cuid())
  contestId       String
  rankableEntryId String
  gameId          String?
  /// Team abbreviation during this NFL week (preserved if player is traded mid-season).
  weekTeam        String?
  /// Admin/data exclusion from the ranking field (suspended, not rostered, duplicate, etc.).
  /// Not for editorial “unlikely to matter” — eligible rostered players should be active.
  excluded        Boolean  @default(false)
  /// Admin manually added an omitted player; preserved across pool rebuilds.
  manuallyAdded   Boolean  @default(false)
  /// Optional internal relevance hint for admin review (never shown as a user ranking).
  suggested       Boolean  @default(false)
  /// Optional internal ordering hint for admin review (not a user-facing rank).
  seedRank        Int?
  inactiveReason  String?
  fantasyPoints   Float?
  actualRank      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contest       RankIQContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  rankableEntry RankableEntry @relation(fields: [rankableEntryId], references: [id], onDelete: Cascade)
  game          NflGame?      @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([contestId, rankableEntryId])
  @@index([contestId, actualRank])
  @@index([contestId, excluded])
}

model RankingSubmission {
  id                 String                 @id @default(cuid())
  contestId          String
  universalProfileId String
  status             SubmissionStatus       @default(DRAFT)
  /// Reveal preference during Sunday 10am–noon CT. Ignored after public release.
  revealPreference   BoardRevealPreference  @default(FREE_REVEAL)
  submittedAt        DateTime?
  lockedAt           DateTime?
  rawScore           Float?
  normalizedScore    Float?
  /// Official board entered via admin Historical / Backfill Entry.
  historicalBackfill Boolean                @default(false)
  /// null = legacy row; resolve via lib/boards/authority (sourceRank inference).
  authority          SubmissionAuthority?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  contest          RankIQContest    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  /// Restrict so deleting a profile cannot silently erase historical RankIQ scores.
  universalProfile UniversalProfile @relation(fields: [universalProfileId], references: [id], onDelete: Restrict)
  picks            RankingPick[]
  officialBoardPublication OfficialBoardPublication?
  officialBoardVersions    OfficialBoardVersion[]

  @@unique([contestId, universalProfileId])
  @@index([contestId, status])
}

/// Official RankEyeQ Board publication state for one owner-authored board.
/// Presentation + history only — grading, scoring, reserves, locks and
/// consensus never read this. No row = Protected. Publication is one-way.
/// Keyed by submission so a board keeps its publication if a claim moves it.
model OfficialBoardPublication {
  id                       String   @id @default(cuid())
  submissionId             String   @unique
  contestId                String
  /// Authoring profile at first publication (immutable).
  profileId                String
  firstPublishedAt         DateTime
  lastPublishedAt          DateTime
  latestPublishedVersionId String   @unique
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  submission             RankingSubmission    @relation(fields: [submissionId], references: [id], onDelete: NoAction)
  contest                RankIQContest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  profile                UniversalProfile     @relation(fields: [profileId], references: [id], onDelete: NoAction)
  latestPublishedVersion OfficialBoardVersion @relation("PublicationLatestVersion", fields: [latestPublishedVersionId], references: [id], onDelete: NoAction)

  @@index([contestId])
  @@index([profileId])
}

/// Immutable snapshot of an owner-authored competitive board. Never updated or
/// deleted. PUBLISHED versions number 1..n per submission; FINAL is always 1,
/// so a second FINAL for the same submission violates the unique constraint.
/// FINAL is the full-lock ranking + slot-lock state at that boundary only;
/// later kickoff-unavailability freezes stay on RankingPick and are never
/// copied here. Never a grading or scoring input.
model OfficialBoardVersion {
  id            String                   @id @default(cuid())
  submissionId  String
  contestId     String
  /// Authoring profile when this version was created (immutable).
  profileId     String
  kind          OfficialBoardVersionKind
  versionNumber Int
  /// Owner who pressed Publish / Update. null for system-captured FINAL.
  authorUserId  String?
  rankingDepth  Int
  reserveCount  Int
  /// sha256 of the ordered competitive board (all slots incl. reserves).
  fingerprint   String
  /// FINAL only: the week's full-lock instant the board competed from.
  boardLockedAt DateTime?
  createdAt     DateTime                 @default(now())

  submission           RankingSubmission          @relation(fields: [submissionId], references: [id], onDelete: NoAction)
  contest              RankIQContest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  profile              UniversalProfile           @relation(fields: [profileId], references: [id], onDelete: NoAction)
  authorUser           User?                      @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  picks                OfficialBoardVersionPick[]
  latestForPublication OfficialBoardPublication?  @relation("PublicationLatestVersion")

  @@unique([submissionId, kind, versionNumber])
  @@index([contestId, kind])
  @@index([profileId])
}

/// One immutable slot of an OfficialBoardVersion (Top N + reserves).
model OfficialBoardVersionPick {
  id              String    @id @default(cuid())
  boardVersionId  String
  rankableEntryId String
  boardRank       Int
  isReserve       Boolean
  reserveSlot     Int?
  /// Display identity frozen at version time.
  displayName     String
  displayTeam     String
  /// Slot-lock state as stored on the live pick when the version was taken.
  slotLocked      Boolean   @default(false)
  lockedAt        DateTime?
  lockedRank      Int?
  committedAt     DateTime?

  boardVersion  OfficialBoardVersion @relation(fields: [boardVersionId], references: [id], onDelete: Cascade)
  rankableEntry RankableEntry        @relation(fields: [rankableEntryId], references: [id], onDelete: Restrict)

  @@unique([boardVersionId, boardRank])
  @@unique([boardVersionId, rankableEntryId])
}

/// Owner-attached weekly content link (video, article, …). Noncompetitive:
/// never affects submissions, board versions, scoring, grading or authority.
model WeeklyContent {
  id                 String            @id @default(cuid())
  profileId          String
  weekId             String
  title              String
  url                String
  type               WeeklyContentType
  position           ContestPosition?
  /// Admin moderation: hidden from public display (audited). Owner edits
  /// never clear it; only an admin restore does.
  suppressedAt       DateTime?
  suppressedByUserId String?
  suppressionReason  String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  profile      UniversalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  week         Week             @relation(fields: [weekId], references: [id], onDelete: Cascade)
  suppressedBy User?            @relation("WeeklyContentSuppressedBy", fields: [suppressedByUserId], references: [id], onDelete: SetNull)

  @@index([profileId, weekId])
  @@index([weekId])
}

model RankingPick {
  id              String    @id @default(cuid())
  submissionId    String
  rankableEntryId String
  predictedRank   Int
  actualRank      Int?
  fantasyPoints   Float?
  basePoints      Float?
  accuracyPoints  Float?
  podiumPoints    Float?
  totalPoints     Float?
  /// Last time this pick/rank was committed while the slot was still editable.
  committedAt     DateTime?
  /// Instant this slot locked (typically the player’s game kickoff or full-board lock).
  lockedAt        DateTime?
  /// Rank frozen at lock — proof of pre-kickoff conviction.
  lockedRank      Int?
  slotLocked      Boolean   @default(false)
  /// Original third-party source rank when this pick came from a benchmark snapshot.
  sourceRank      Int?
  /// When this pick's kickoff locked: active-board entry IDs that were ranked
  /// ahead of this pick (anti-hindsight eligibility for reserve promotion).
  /// JSON string[] — only meaningful for reserve slots (predictedRank > scoringDepth).
  reserveEligiblePredecessorIds Json?
  /// Frozen at this pick's kickoff: whether availability was promotion-unavailable.
  /// null = kickoff not yet reached (derive from live availability).
  wasUnavailableAtKickoff Boolean?

  submission    RankingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rankableEntry RankableEntry     @relation(fields: [rankableEntryId], references: [id], onDelete: Restrict)

  @@unique([submissionId, predictedRank])
  @@unique([submissionId, rankableEntryId])
}

/// Manual capture of a third-party expert ranking. Never silently overwritten.
/// Official on-time boards still grade through RankingSubmission + lib/scoring.ts.
model BenchmarkSnapshot {
  id                 String                    @id @default(cuid())
  universalProfileId String
  contestId          String
  weekId             String
  captureType        BenchmarkCaptureType
  capturedAt         DateTime
  sourcePublishedAt  DateTime?
  sourceUrl          String?
  notes              String?
  rawText            String?                   @db.Text
  status             BenchmarkSnapshotStatus   @default(CAPTURED)
  publicBoardAllowed Boolean                   @default(true)
  late               Boolean                   @default(false)
  /// Admin Historical / Backfill Entry — wall-clock transcription after lock.
  historicalBackfill Boolean                   @default(false)
  /// Wall-clock instant when admin used Backfill Mode (distinct from sourcePublishedAt).
  backfilledAt       DateTime?
  /// Admin entry occurred after Week.fullLockAt (wall clock).
  enteredAfterFullLock Boolean                 @default(false)
  /// Admin entry occurred while Week.status was COMPLETE.
  enteredAfterWeekComplete Boolean             @default(false)
  adminUserId        String
  correctionOfId     String?
  correctionReason   String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  universalProfile UniversalProfile      @relation(fields: [universalProfileId], references: [id], onDelete: Restrict)
  contest          RankIQContest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  week             Week                  @relation(fields: [weekId], references: [id], onDelete: Cascade)
  adminUser        User                  @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  correctionOf     BenchmarkSnapshot?    @relation("SnapshotCorrections", fields: [correctionOfId], references: [id], onDelete: SetNull)
  corrections      BenchmarkSnapshot[]   @relation("SnapshotCorrections")
  picks            BenchmarkSnapshotPick[]

  @@index([contestId, universalProfileId, capturedAt])
  @@index([weekId, universalProfileId])
  @@index([correctionOfId])
}

model BenchmarkSnapshotPick {
  id              String   @id @default(cuid())
  snapshotId      String
  rankableEntryId String?
  rawName         String
  sourceRank      Int
  rankIqRank      Int?
  excluded        Boolean  @default(false)
  exclusionReason String?
  issue           String?
  selected        Boolean  @default(false)
  slotLocked      Boolean  @default(false)
  lockedAt        DateTime?
  lockedRank      Int?
  kickoffAt       DateTime?

  snapshot      BenchmarkSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  rankableEntry RankableEntry?    @relation(fields: [rankableEntryId], references: [id], onDelete: SetNull)

  @@index([snapshotId, sourceRank])
  @@index([rankableEntryId])
}

/// Operator audit for manual NFL schedule/pool/results pastes. No secrets.
model ManualImportLog {
  id            String   @id @default(cuid())
  adminUserId   String
  weekId        String?
  importType    String
  rowCount      Int      @default(0)
  createdCount  Int      @default(0)
  updatedCount  Int      @default(0)
  excludedCount Int      @default(0)
  warnings      Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  adminUser User  @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  week      Week? @relation(fields: [weekId], references: [id], onDelete: SetNull)

  @@index([weekId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([importType])
}

/// Versioned RankEyeQ ranking formula — frozen on each graded contest.
model RankingScoringVersion {
  id          String               @id @default(cuid())
  slug        String               @unique
  label       String
  status      ScoringVersionStatus @default(DRAFT)
  description String?
  /// JSON matching RankingScoringConfig (see lib/ranking-scoring-version.ts).
  config      Json
  activatedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  contests       RankIQContest[]
  activeSeasons  Season[] @relation("SeasonActiveScoringVersion")
}

/// Published legal/policy document revision (placeholder until legal review).
model PolicyDocument {
  id             String   @id @default(cuid())
  slug           String
  version        String
  title          String
  content        String   @db.Text
  /// True until counsel approves final language.
  requiresReview Boolean  @default(true)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  acceptances PolicyAcceptance[]

  @@unique([slug, version])
  @@index([slug, publishedAt])
}

/// Records which policy revision a user accepted and when.
model PolicyAcceptance {
  id               String   @id @default(cuid())
  userId           String
  policyDocumentId String
  acceptedAt       DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyDocument PolicyDocument @relation(fields: [policyDocumentId], references: [id], onDelete: Restrict)

  @@unique([userId, policyDocumentId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// RankEyeQ Waivers — Official Waiver Snapshot evidence (Phase 1 foundation).
// Separate from Rankings: no Rankings table references these models.
// Frozen evidence is immutable; corrections create a new snapshot version.
// Every relation is Restrict so Season/Week/player/user deletes cannot erase
// competitive evidence (Week cascades from Season).
// ---------------------------------------------------------------------------

enum WaiverSnapshotStatus {
  FROZEN
  SUPERSEDED
}

enum WaiverEvidenceRole {
  /// Row from the weekly ownership paste; evaluated for eligibility.
  CANDIDATE
  /// Targeted observation for a previously called player (may be >= 50%).
  FOLLOW_UP
}

enum WaiverEligibility {
  ELIGIBLE
  EXCLUDED
  /// Evidence only (FOLLOW_UP rows); never part of the Waiver pool.
  OBSERVATION_ONLY
}

enum WaiverExclusionReason {
  AT_OR_ABOVE_THRESHOLD
  BYE
  NO_SCHEDULED_GAME
  HARD_UNAVAILABLE
  NOT_ON_NFL_ROSTER
  POSITION_MISMATCH
  ADMIN_EXCLUDED
}

enum WaiverMatchMethod {
  EXTERNAL_ID
  EXACT_NAME_TEAM
  ALIAS_TEAM
  ADMIN_CONFIRMED
}

enum WaiverCorrectionCase {
  PRE_SUBMISSION
  OPEN_WITH_SUBMISSIONS
  POST_LOCK
  POST_GRADE
}

/// Records how a correction relates to boards. Post-lock competitive treatment
/// is not authorized yet: such corrections are evidence-only until a policy exists.
enum WaiverCorrectionPolicy {
  NO_BOARD_EFFECT
  /// Pre-lock: affected boards are flagged; owners may revise while open.
  AFFECTED_BOARDS_FLAGGED
  /// Post-lock / post-grade: evidence preserved; treatment requires a product decision.
  POLICY_DECISION_REQUIRED
}

/// One frozen version of the Official Waiver Snapshot for a week.
model WaiverSnapshot {
  id                 String                @id @default(cuid())
  seasonId           String
  weekId             String
  version            Int
  status             WaiverSnapshotStatus  @default(FROZEN)
  /// Equals weekId on the current version only; null once superseded (one current per week).
  currentForWeekId   String?               @unique
  /// Ownership threshold in basis points (5000 = 50.00%). Eligible iff rosteredBps < thresholdBps.
  thresholdBps       Int                   @default(5000)
  sourceLabel        String
  sourceUrl          String?
  observedAt         DateTime
  frozenAt           DateTime              @default(now())
  frozenByUserId     String
  rawInputSha256     String
  entriesFingerprint String
  candidateCount     Int
  eligibleCount      Int
  excludedCount      Int
  followUpCount      Int
  supersedesId       String?               @unique
  correctionCase     WaiverCorrectionCase?
  correctionReason   String?
  /// Provenance pointer to ManualImportLog.id (no FK; import logs stay independent).
  manualImportLogId  String?               @unique

  season          Season                     @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  week            Week                       @relation(fields: [weekId], references: [id], onDelete: Restrict)
  frozenBy        User                       @relation("WaiverSnapshotFrozenBy", fields: [frozenByUserId], references: [id], onDelete: Restrict)
  supersedes      WaiverSnapshot?            @relation("WaiverSnapshotSupersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy    WaiverSnapshot?            @relation("WaiverSnapshotSupersedes")
  entries         WaiverSnapshotEntry[]
  correctionsFrom WaiverSnapshotCorrection[] @relation("WaiverSnapshotCorrectionFrom")
  correctionsTo   WaiverSnapshotCorrection[] @relation("WaiverSnapshotCorrectionTo")
  contests        WaiverContest[]
  revisions       WaiverSubmissionRevision[]
  conflictResolutions WaiverConflictResolution[]
  contestResults      WaiverContestResult[]
  emptyPositionResults WaiverEmptyPositionResult[]
  aiResponses          WaiverAiResponse[]
  aiHistoricalEvidence WaiverAiHistoricalEvidence[]

  @@unique([weekId, version])
  @@index([seasonId, weekId])
}

/// Per-player evidence row copied at freeze. Never depends on mutable live rows.
model WaiverSnapshotEntry {
  id                              String                         @id @default(cuid())
  snapshotId                      String
  rankableEntryId                 String
  evidenceRole                    WaiverEvidenceRole
  position                        ContestPosition
  displayNameAtFreeze             String
  teamAtFreeze                    String?
  /// Roster percentage in basis points (49.5% = 4950).
  rosteredBps                     Int
  sourceLabel                     String
  sourceUrl                       String?
  observedAt                      DateTime
  inputLineNumber                 Int
  inputLine                       String
  matchMethod                     WaiverMatchMethod
  eligibility                     WaiverEligibility
  exclusionReason                 WaiverExclusionReason?
  exclusionNote                   String?
  nflGameId                       String?
  opponentAtFreeze                String?
  kickoffAtFreeze                 DateTime?
  isByeAtFreeze                   Boolean
  availabilityDesignationAtFreeze WeeklyAvailabilityDesignation?
  rosterStatusAtFreeze            String?
  availabilitySourceAtFreeze      String?
  hardUnavailableAtFreeze         Boolean
  /// RankableEntry provider/externalId at freeze; both set or both NULL. NULL only on rows frozen before Stage 4B.1 (never backfilled).
  identityProviderAtFreeze        String?
  identityExternalIdAtFreeze      String?

  snapshot      WaiverSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  rankableEntry RankableEntry  @relation(fields: [rankableEntryId], references: [id], onDelete: Restrict)
  nflGame       NflGame?       @relation(fields: [nflGameId], references: [id], onDelete: Restrict)
  calls         WaiverCall[]
  conflictResolutions WaiverConflictResolution[]
  poolResults         WaiverPoolResult[]

  @@unique([snapshotId, rankableEntryId])
  @@index([rankableEntryId, snapshotId])
  @@index([snapshotId, position, eligibility])
}

/// Field-level correction record linking an original and a corrected snapshot version.
model WaiverSnapshotCorrection {
  id                      String                 @id @default(cuid())
  fromSnapshotId          String
  toSnapshotId            String
  rankableEntryId         String?
  field                   String
  originalValue           Json
  correctedValue          Json
  reason                  String
  correctionCase          WaiverCorrectionCase
  policy                  WaiverCorrectionPolicy
  eligibilityBefore       WaiverEligibility?
  eligibilityAfter        WaiverEligibility?
  affectedSubmissionCount Int                    @default(0)
  affectedCallIds         Json?
  operatorUserId          String
  createdAt               DateTime               @default(now())

  fromSnapshot  WaiverSnapshot @relation("WaiverSnapshotCorrectionFrom", fields: [fromSnapshotId], references: [id], onDelete: Restrict)
  toSnapshot    WaiverSnapshot @relation("WaiverSnapshotCorrectionTo", fields: [toSnapshotId], references: [id], onDelete: Restrict)
  rankableEntry RankableEntry? @relation(fields: [rankableEntryId], references: [id], onDelete: Restrict)
  operator      User           @relation("WaiverSnapshotCorrectionOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)

  @@index([toSnapshotId])
  @@index([fromSnapshotId])
  @@index([rankableEntryId])
}

// ---------------------------------------------------------------------------
// RankEyeQ Waivers — competition foundation (Phase 2).
// Separate from Rankings contests/submissions. Revisions and calls are
// append-only; lock authority is the database clock (see the migration's
// trigger backstops). No grading, results or reveal surfaces yet.
// ---------------------------------------------------------------------------

enum WaiverContestStatus {
  OPEN
  LOCKED
}

enum WaiverSubmissionStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum WaiverRevisionKind {
  DRAFT
  SUBMISSION
}

/// One Waiver Podium per week and position. The effective phase is derived
/// from locksAt; stored LOCKED is a lazy, idempotent stamp.
model WaiverContest {
  id              String              @id @default(cuid())
  weekId          String
  position        ContestPosition
  /// Pinned snapshot version. Changes only through a pre-lock supersession.
  snapshotId      String
  status          WaiverContestStatus @default(OPEN)
  /// Copied from WAIVER_MAX_CALLS / WAIVER_RESULT_FIELD_SIZE at open.
  maxCalls        Int
  resultFieldSize Int
  scoringVersion  String
  opensAt         DateTime
  /// Tuesday 7:00 PM America/Chicago before the week's first kickoff.
  locksAt         DateTime
  openedByUserId  String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  week        Week               @relation(fields: [weekId], references: [id], onDelete: Restrict)
  snapshot    WaiverSnapshot     @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  openedBy    User               @relation("WaiverContestOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  submissions WaiverSubmission[]
  conflictResolutions WaiverConflictResolution[]
  results             WaiverContestResult[]
  boardGrades         WaiverBoardGrade[]
  resultAuthority     WaiverContestResultAuthority?
  aiResponses         WaiverAiResponse[]
  aiHistoricalEvidence WaiverAiHistoricalEvidence[]

  @@unique([weekId, position])
  @@index([snapshotId])
}

/// One Waiver board per contest and profile. Board content lives in
/// append-only revisions; the submission only points at them.
model WaiverSubmission {
  id                 String                 @id @default(cuid())
  contestId          String
  universalProfileId String
  /// Login that created the board: the owner (OWNER_AUTHORED, one board per login per
  /// contest) or the importing admin (SYSTEM_OPERATED AI boards).
  createdByUserId    String
  authority          SubmissionAuthority
  status             WaiverSubmissionStatus @default(DRAFT)
  currentRevisionId  String?                @unique
  /// Final SUBMISSION revision created before locksAt (set by the lock stamp).
  lockedRevisionId   String?                @unique
  /// Instant of the latest SUBMISSION revision.
  submittedAt        DateTime?
  /// Equals the contest's locksAt once stamped.
  lockedAt           DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  contest          WaiverContest              @relation(fields: [contestId], references: [id], onDelete: Restrict)
  universalProfile UniversalProfile           @relation(fields: [universalProfileId], references: [id], onDelete: Restrict)
  createdBy        User                       @relation("WaiverSubmissionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  currentRevision  WaiverSubmissionRevision?  @relation("WaiverSubmissionCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  lockedRevision   WaiverSubmissionRevision?  @relation("WaiverSubmissionLockedRevision", fields: [lockedRevisionId], references: [id], onDelete: Restrict)
  revisions        WaiverSubmissionRevision[] @relation("WaiverSubmissionRevisions")
  boardGrades      WaiverBoardGrade[]
  gradeAuthority   WaiverBoardGradeAuthority?

  @@unique([contestId, universalProfileId])
  /// One owner-authored board per login per contest. SYSTEM_OPERATED (AI) boards are
  /// created by admins, so one admin login may operate several AI boards in a contest.
  @@unique([contestId, createdByUserId], map: "WaiverSubmission_contestId_createdByUserId_owner_key", where: raw("authority = 'OWNER_AUTHORED'::\"SubmissionAuthority\""))
  @@index([contestId, status])
}

/// Immutable board revision (DRAFT or SUBMISSION). Never updated or deleted.
model WaiverSubmissionRevision {
  id             String             @id @default(cuid())
  submissionId   String
  revisionNumber Int
  kind           WaiverRevisionKind
  /// Snapshot version this board was validated against.
  snapshotId     String
  /// 0 on a SUBMISSION revision is an explicit abstention.
  callCount      Int
  fingerprint    String
  authorUserId   String
  /// Authoritative database-clock instant of the write (no default).
  createdAt      DateTime

  submission WaiverSubmission  @relation("WaiverSubmissionRevisions", fields: [submissionId], references: [id], onDelete: Restrict)
  snapshot   WaiverSnapshot    @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  author     User              @relation("WaiverRevisionAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  calls      WaiverCall[]
  currentFor WaiverSubmission? @relation("WaiverSubmissionCurrentRevision")
  lockedFor  WaiverSubmission? @relation("WaiverSubmissionLockedRevision")
  boardGrades WaiverBoardGrade[]
  aiResponse  WaiverAiResponse?

  @@unique([submissionId, revisionNumber])
  @@index([submissionId, kind, createdAt])
}

/// One ordered call (slot 1 = WIN, 2 = PLACE, 3 = SHOW, 4, 5) on the frozen
/// eligible snapshot row it was validated against.
model WaiverCall {
  id              String @id @default(cuid())
  revisionId      String
  slot            Int
  snapshotEntryId String

  revision      WaiverSubmissionRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  snapshotEntry WaiverSnapshotEntry      @relation(fields: [snapshotEntryId], references: [id], onDelete: Restrict)
  callGrades    WaiverCallGrade[]

  @@unique([revisionId, slot])
  @@unique([revisionId, snapshotEntryId])
  @@index([snapshotEntryId])
}

// ---------------------------------------------------------------------------
// RankEyeQ Waivers — canonical artifact authority (Stage 4B.2).
// Imported SNG canonical NFL weekly performance artifacts: immutable metadata,
// the exact artifact text in a separate 1:1 table, and an append-only
// publication event log. Importing never grades and never touches contests.
// ---------------------------------------------------------------------------

/// SNG publication state as attested by a RankEyeQ operator; the artifact bytes never carry it.
enum WaiverCanonicalPublicationState {
  ACCEPTED
  SUPERSEDED
  WITHDRAWN
}

/// Immutable metadata for one imported SNG canonical artifact revision.
model WaiverCanonicalArtifact {
  id                        String                          @id @default(cuid())
  artifactId                String                          @unique
  seriesKey                 String
  revision                  Int
  /// SNG artifact ID of the already-imported revision n-1 of the same series (null for revision 1).
  supersedesArtifactId      String?                         @unique
  contentChecksum           String                          @unique
  schemaVersion             String
  serializationVersion      String
  rulesetCode               String
  rulesetVersion            Int
  rulesetDefinitionChecksum String
  engineVersion             String
  positionPolicyVersion     String
  readinessPolicyVersion    String
  acceptanceId              String
  acceptedAt                DateTime
  /// Opaque SNG account that accepted the artifact (metadata inside the bytes).
  sngAcceptedById           String
  generatedAt               DateTime
  readinessEvidenceChecksum String
  manifestChecksum          String
  runFingerprint            String
  inputSetChecksum          String
  sourceRevisionFingerprint String
  season                    Int
  weekNumber                Int
  weekId                    String
  qbFieldSize               Int
  rbFieldSize               Int
  wrFieldSize               Int
  teFieldSize               Int
  defFieldSize              Int
  participantCount          Int
  /// UTF-8 byte length of the stored artifact text.
  byteLength                Int
  defCrosswalkVersion       String
  /// Digest the operator read from the authenticated SNG download; always equals contentChecksum.
  expectedContentChecksum   String
  attestedPublicationState  WaiverCanonicalPublicationState
  /// How SNG publication authority was established at import (operator attestation only).
  authorityBasis            String
  sourceReference           String
  sourceObservedAt          DateTime
  attestationVersion        String
  attestationText           String
  previewFingerprint        String
  importedByUserId          String
  /// Database clock (`waiver_utc_now()`), set by the insert trigger.
  importedAt                DateTime                        @default(now())

  week            Week                            @relation(fields: [weekId], references: [id], onDelete: Restrict)
  importedBy      User                            @relation("WaiverCanonicalArtifactImportedBy", fields: [importedByUserId], references: [id], onDelete: Restrict)
  supersedes      WaiverCanonicalArtifact?        @relation("WaiverCanonicalArtifactSupersedes", fields: [supersedesArtifactId], references: [artifactId], onDelete: Restrict)
  supersededBy    WaiverCanonicalArtifact?        @relation("WaiverCanonicalArtifactSupersedes")
  content         WaiverCanonicalArtifactContent?
  events          WaiverCanonicalArtifactEvent[]  @relation("WaiverCanonicalArtifactEvents")
  successorEvents WaiverCanonicalArtifactEvent[]  @relation("WaiverCanonicalArtifactEventSuccessor")
  conflictResolutions WaiverConflictResolution[]
  contestResults      WaiverContestResult[]
  gradeRuns           WaiverGradeRun[]
  gradeApprovals      WaiverGradeApproval[]

  @@unique([seriesKey, revision])
  @@index([weekId, revision])
}

/// The exact imported artifact text (1:1). Never selected by list or leaderboard queries.
model WaiverCanonicalArtifactContent {
  artifactRowId String @id
  contentText   String
  /// sha256 of the UTF-8 text (database-checked); distinct from the SNG contentChecksum.
  textSha256    String
  byteLength    Int

  artifact WaiverCanonicalArtifact @relation(fields: [artifactRowId], references: [id], onDelete: Restrict)
}

/// Append-only publication history. `state` is the SNG publication state being
/// attested; `basis` and `recordedAt` describe RankEyeQ's local record of it.
model WaiverCanonicalArtifactEvent {
  id                     String                          @id @default(cuid())
  artifactRowId          String
  sequence               Int
  state                  WaiverCanonicalPublicationState
  /// The imported successor revision (SUPERSEDED only).
  successorArtifactRowId String?
  /// IMPORT_ATTESTATION (ACCEPTED), SUCCESSOR_IMPORT (SUPERSEDED) or OPERATOR_WITHDRAWAL (WITHDRAWN).
  basis                  String
  sourceReference        String
  sourceObservedAt       DateTime
  attestationVersion     String
  reason                 String?
  operatorUserId         String
  /// Database clock (`waiver_utc_now()`), set by the insert trigger.
  recordedAt             DateTime                        @default(now())

  artifact  WaiverCanonicalArtifact  @relation("WaiverCanonicalArtifactEvents", fields: [artifactRowId], references: [id], onDelete: Restrict)
  successor WaiverCanonicalArtifact? @relation("WaiverCanonicalArtifactEventSuccessor", fields: [successorArtifactRowId], references: [id], onDelete: Restrict)
  operator  User                     @relation("WaiverCanonicalArtifactEventOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)

  @@unique([artifactRowId, sequence])
  @@index([successorArtifactRowId])
}

// ---------------------------------------------------------------------------
// RankEyeQ Waivers — immutable results and grading authority (Stage 4B.3).
// Storage only: D3 resolutions, versioned contest/pool results, grade runs
// with board and call grades, separate grading approvals, an append-only
// authority log and current-authority pointers that move week-atomically.
// No workflow writes these tables yet. Fingerprints:
// docs/waivers-grading-fingerprints.md.
// ---------------------------------------------------------------------------

enum WaiverConflictKind {
  BYE_VS_SCHEDULED
  TEAM_CHANGED
}

enum WaiverConflictResolutionTreatment {
  SCORE_AS_RANKED
  NON_PARTICIPANT_ZERO
  NEUTRALIZED
}

enum WaiverPoolMemberCategory {
  /// Eligible CANDIDATE row of the contest's pinned snapshot.
  ELIGIBLE_POOL_MEMBER
  /// Called on a locked board but not an eligible member of the pinned snapshot (pre-lock invalidation).
  INVALIDATED_CALLED_PLAYER
}

/// Stage 4A canonical class of a stored member (BLOCKED is never stored).
enum WaiverCanonicalResultClass {
  RANKED
  NON_PARTICIPANT
  SYSTEMIC_NEUTRALIZE
  SNAPSHOT_CONFLICT
}

enum WaiverResultTreatment {
  RANKED
  NON_PARTICIPANT_ZERO
  NEUTRALIZED
  INVALIDATED_PRE_LOCK
}

enum WaiverNeutralizationPrecedence {
  D2_NEUTRALIZATION_OVER_C2_INVALIDATION
  D3_NEUTRALIZATION_OVER_C2_INVALIDATION
}

enum WaiverInvalidationBasis {
  NOT_ELIGIBLE_IN_PINNED_SNAPSHOT
  ABSENT_FROM_PINNED_SNAPSHOT
}

/// NA_NO_EFFECTIVE_SLOTS: scoreable calls remain but no effective available
/// slot does (pre-lock correction); calls keep their individual outcomes.
enum WaiverBoardResultKind {
  SCORED
  NA_ZERO_CALL
  NA_ALL_NEUTRALIZED
  NA_NO_EFFECTIVE_SLOTS
}

/// Why a board is NA_NO_EFFECTIVE_SLOTS (database-derived from its counts).
enum WaiverUngradableReason {
  /// The corrected eligible pool is empty (zero available slots).
  CORRECTED_POOL_EMPTY
  /// Neutralized calls consumed every corrected available slot.
  NEUTRALIZATIONS_CONSUMED_SLOTS
}

/// Board-level honors. The per-call exact-slot label is EXACT, never an honor.
enum WaiverHonor {
  PERFECT_CALL
  PERFECT_PODIUM
  PERFECT_FIVE
}

enum WaiverGradeInitiator {
  OPERATOR
  SYSTEM
}

enum WaiverGradeApprovalPolicy {
  /// V1: the importing admin may approve, through a separate explicit approval record.
  SINGLE_ADMIN_EXPLICIT
  /// The approver must differ from the artifact importer and the grade-run initiator.
  SEPARATE_APPROVER
}

enum WaiverGradeAuthorityChangeType {
  INITIAL_GRADE
  REGRADE
}

/// Immutable D3 decision for one snapshot/canonical conflict, bound to one
/// artifact revision. Never carried forward: a new revision needs a new row
/// (which may reference the old one through reconfirmsResolutionId).
model WaiverConflictResolution {
  id                      String                            @id @default(cuid())
  weekId                  String
  contestId               String
  position                ContestPosition
  snapshotId              String
  snapshotEntryId         String
  artifactRowId           String
  artifactRevision        Int
  artifactContentChecksum String
  sngParticipantId        String
  /// Stage 4A conflict key (entry, participant, kind, artifact content checksum).
  conflictKey             String
  conflictKind            WaiverConflictKind
  /// 1 for the first decision on this conflict and artifact; n replaces n-1.
  sequence                Int
  supersedesResolutionId  String?                           @unique
  /// Lineage only: the decision on an earlier artifact revision this explicitly reconfirms.
  reconfirmsResolutionId  String?
  resolution              WaiverConflictResolutionTreatment
  evidenceReference       String
  reason                  String
  inputFingerprint        String
  resolvedByUserId        String
  /// Database clock (`waiver_utc_now()`), set by the insert trigger.
  resolvedAt              DateTime                          @default(now())

  contest        WaiverContest              @relation(fields: [contestId], references: [id], onDelete: Restrict)
  snapshot       WaiverSnapshot             @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  snapshotEntry  WaiverSnapshotEntry        @relation(fields: [snapshotEntryId], references: [id], onDelete: Restrict)
  artifact       WaiverCanonicalArtifact    @relation(fields: [artifactRowId], references: [id], onDelete: Restrict)
  supersedes     WaiverConflictResolution?  @relation("WaiverConflictResolutionSupersedes", fields: [supersedesResolutionId], references: [id], onDelete: Restrict)
  supersededBy   WaiverConflictResolution?  @relation("WaiverConflictResolutionSupersedes")
  reconfirms     WaiverConflictResolution?  @relation("WaiverConflictResolutionReconfirms", fields: [reconfirmsResolutionId], references: [id], onDelete: Restrict)
  reconfirmedBy  WaiverConflictResolution[] @relation("WaiverConflictResolutionReconfirms")
  resolvedBy     User                       @relation("WaiverConflictResolutionResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  poolResults    WaiverPoolResult[]

  @@unique([artifactRowId, conflictKey, sequence])
  @@index([contestId, artifactRowId])
  @@index([snapshotId])
  @@index([snapshotEntryId])
  @@index([reconfirmsResolutionId])
  @@index([resolvedByUserId])
}

/// Immutable canonical result version for one contest: source facts and
/// their Waivers interpretation, not anyone's grade.
model WaiverContestResult {
  id                       String          @id @default(cuid())
  contestId                String
  weekId                   String
  position                 ContestPosition
  /// The contest's pinned snapshot version at lock.
  snapshotId               String
  artifactRowId            String
  artifactContentChecksum  String
  /// Contiguous per contest, from 1.
  resultVersion            Int
  resultsPolicyVersion     String
  sngResultSetChecksum     String
  sourceFingerprint        String
  snapshotFingerprint      String
  resolutionSetFingerprint String
  inputFingerprint         String
  resultFingerprint        String
  /// Target Waiver result field (3, or 5 for WR), copied from the contest.
  resultFieldSize          Int
  eligiblePoolSize         Int
  /// Members holding an effective Waiver pool rank (RANKED treatment).
  effectivePoolSize        Int
  /// min(resultFieldSize, effectivePoolSize).
  effectiveFieldSize       Int
  /// min(contest maxCalls, eligiblePoolSize).
  effectiveAvailableSlots  Int
  invalidatedCalledCount   Int
  /// Database clock (`waiver_utc_now()`), set by the insert trigger.
  createdAt                DateTime        @default(now())

  contest       WaiverContest                  @relation(fields: [contestId], references: [id], onDelete: Restrict)
  snapshot      WaiverSnapshot                 @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  artifact      WaiverCanonicalArtifact        @relation(fields: [artifactRowId], references: [id], onDelete: Restrict)
  poolResults   WaiverPoolResult[]
  boardGrades   WaiverBoardGrade[]
  qbGradeRuns   WaiverGradeRun[]               @relation("WaiverGradeRunQbResult")
  rbGradeRuns   WaiverGradeRun[]               @relation("WaiverGradeRunRbResult")
  wrGradeRuns   WaiverGradeRun[]               @relation("WaiverGradeRunWrResult")
  teGradeRuns   WaiverGradeRun[]               @relation("WaiverGradeRunTeResult")
  defGradeRuns  WaiverGradeRun[]               @relation("WaiverGradeRunDefResult")
  authorities   WaiverContestResultAuthority[]

  @@unique([contestId, resultVersion])
  @@unique([contestId, inputFingerprint])
  @@index([weekId])
  @@index([snapshotId])
  @@index([artifactRowId])
}

/// Immutable per-player row of a contest result: every eligible frozen pool
/// member, plus locked called players outside the pool, kept in separate categories.
model WaiverPoolResult {
  id                        String                          @id @default(cuid())
  contestResultId           String
  category                  WaiverPoolMemberCategory
  /// Pinned-snapshot entry; NULL only for an invalidated player absent from the pinned snapshot.
  snapshotEntryId           String?
  rankableEntryId           String
  position                  ContestPosition
  identityProvider          String
  identityExternalId        String
  sngParticipantId          String
  participationState        String
  participantDisposition    String
  canonicalClass            WaiverCanonicalResultClass
  canonicalPointsHundredths Int?
  canonicalPositionRank     Int?
  sngResultFingerprint      String?
  treatment                 WaiverResultTreatment
  /// Effective fantasy points in integer hundredths; NULL when neutralized.
  fpHundredths              Int?
  /// Effective shared Waiver pool rank over RANKED members only.
  waiverPoolRank            Int?
  neutralizationPrecedence  WaiverNeutralizationPrecedence?
  conflictResolutionId      String?
  invalidationBasis         WaiverInvalidationBasis?
  invalidatedBySnapshotId   String?
  rowFingerprint            String

  contestResult      WaiverContestResult       @relation(fields: [contestResultId], references: [id], onDelete: Restrict)
  snapshotEntry      WaiverSnapshotEntry?      @relation(fields: [snapshotEntryId], references: [id], onDelete: Restrict)
  rankableEntry      RankableEntry             @relation(fields: [rankableEntryId], references: [id], onDelete: Restrict)
  conflictResolution WaiverConflictResolution? @relation(fields: [conflictResolutionId], references: [id], onDelete: Restrict)
  callGrades         WaiverCallGrade[]

  @@unique([contestResultId, rankableEntryId])
  @@unique([contestResultId, snapshotEntryId])
  @@index([snapshotEntryId])
  @@index([rankableEntryId])
  @@index([conflictResolutionId])
}

/// Immutable record of one grading execution covering all five positions of
/// a week. Lifecycle (proposed / current / superseded) is derived from the
/// approval and authority tables, never stored here.
model WaiverGradeRun {
  id                       String               @id @default(cuid())
  weekId                   String
  /// Contiguous per week, from 1.
  runNumber                Int
  artifactRowId            String
  artifactContentChecksum  String
  /// Each position has exactly one of a contest result or an explicit empty-position result.
  qbContestResultId        String?
  rbContestResultId        String?
  wrContestResultId        String?
  teContestResultId        String?
  defContestResultId       String?
  qbEmptyPositionResultId  String?
  rbEmptyPositionResultId  String?
  wrEmptyPositionResultId  String?
  teEmptyPositionResultId  String?
  defEmptyPositionResultId String?
  snapshotSetFingerprint   String
  resolutionSetFingerprint String
  gradingRulesetVersion    String
  scoringVersion           String
  inputFingerprint         String
  outputFingerprint        String
  boardGradeCount          Int
  initiator                WaiverGradeInitiator
  initiatedByUserId        String?
  /// Database clock (`waiver_utc_now()`), set by the insert trigger.
  createdAt                DateTime             @default(now())

  week              Week                           @relation(fields: [weekId], references: [id], onDelete: Restrict)
  artifact          WaiverCanonicalArtifact        @relation(fields: [artifactRowId], references: [id], onDelete: Restrict)
  qbContestResult   WaiverContestResult?           @relation("WaiverGradeRunQbResult", fields: [qbContestResultId], references: [id], onDelete: Restrict)
  rbContestResult   WaiverContestResult?           @relation("WaiverGradeRunRbResult", fields: [rbContestResultId], references: [id], onDelete: Restrict)
  wrContestResult   WaiverContestResult?           @relation("WaiverGradeRunWrResult", fields: [wrContestResultId], references: [id], onDelete: Restrict)
  teContestResult   WaiverContestResult?           @relation("WaiverGradeRunTeResult", fields: [teContestResultId], references: [id], onDelete: Restrict)
  defContestResult  WaiverContestResult?           @relation("WaiverGradeRunDefResult", fields: [defContestResultId], references: [id], onDelete: Restrict)
  qbEmptyPositionResult  WaiverEmptyPositionResult? @relation("WaiverGradeRunQbEmpty", fields: [qbEmptyPositionResultId], references: [id], onDelete: Restrict)
  rbEmptyPositionResult  WaiverEmptyPositionResult? @relation("WaiverGradeRunRbEmpty", fields: [rbEmptyPositionResultId], references: [id], onDelete: Restrict)
  wrEmptyPositionResult  WaiverEmptyPositionResult? @relation("WaiverGradeRunWrEmpty", fields: [wrEmptyPositionResultId], references: [id], onDelete: Restrict)
  teEmptyPositionResult  WaiverEmptyPositionResult? @relation("WaiverGradeRunTeEmpty", fields: [teEmptyPositionResultId], references: [id], onDelete: Restrict)
  defEmptyPositionResult WaiverEmptyPositionResult? @relation("WaiverGradeRunDefEmpty", fields: [defEmptyPositionResultId], references: [id], onDelete: Restrict)
  initiatedBy       User?                          @relation("WaiverGradeRunInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  boardGrades       WaiverBoardGrade[]
  approvals         WaiverGradeApproval[]
  changesAsNew      WaiverGradeAuthorityChange[]   @relation("WaiverGradeAuthorityChangeNewRun")
  changesAsPrior    WaiverGradeAuthorityChange[]   @relation("WaiverGradeAuthorityChangePriorRun")
  weekAuthorities   WaiverWeekGradeAuthority[]
  contestAuthorities WaiverContestResultAuthority[]
  boardAuthorities  WaiverBoardGradeAuthority[]

  @@unique([weekId, runNumber])
  @@unique([weekId, inputFingerprint])
  @@index([artifactRowId])
  @@index([qbContestResultId])
  @@index([rbContestResultId])
  @@index([wrContestResultId])
  @@index([teContestResultId])
  @@index([defContestResultId])
  @@index([qbEmptyPositionResultId])
  @@index([rbEmptyPositionResultId])
  @@index([wrEmptyPositionResultId])
  @@index([teEmptyPositionResultId])
  @@index([defEmptyPositionResultId])
  @@index([initiatedByUserId])
}

/// Explicit, immutable record that a week has no Waiver contest at a position
/// because the week's current frozen snapshot has no eligible candidate there
/// (contest opening refused EMPTY_ELIGIBLE_POOL). It carries no players, pool
/// rows or grades; a grade run cites it in place of a contest result.
model WaiverEmptyPositionResult {
  id                   String          @id @default(cuid())
  weekId               String
  position             ContestPosition
  snapshotId           String
  snapshotFingerprint  String
  /// Always 0 (database-verified against the frozen snapshot).
  eligiblePoolSize     Int
  resultsPolicyVersion String
  resultFingerprint    String
  /// Database clock (`waiver_utc_now()`), set by the insert trigger.
  createdAt            DateTime        @default(now())

  week        Week           @relation(fields: [weekId], references: [id], onDelete: Restrict)
  snapshot    WaiverSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  qbGradeRuns  WaiverGradeRun[] @relation("WaiverGradeRunQbEmpty")
  rbGradeRuns  WaiverGradeRun[] @relation("WaiverGradeRunRbEmpty")
  wrGradeRuns  WaiverGradeRun[] @relation("WaiverGradeRunWrEmpty")
  teGradeRuns  WaiverGradeRun[] @relation("WaiverGradeRunTeEmpty")
  defGradeRuns WaiverGradeRun[] @relation("WaiverGradeRunDefEmpty")

  @@unique([weekId, position, snapshotId])
  @@index([snapshotId])
}

/// Immutable grade of one locked submitted board in one grade run. Call
/// quality = earned/max raw points, coverage = coverage calls / effective
/// available slots, coverage modifier = numerator/denominator (exact rationals).
model WaiverBoardGrade {
  id                            String                @id @default(cuid())
  gradeRunId                    String
  contestId                     String
  contestResultId               String
  position                      ContestPosition
  submissionId                  String
  /// The submission's locked revision (drafts are never graded).
  revisionId                    String
  /// The original submission's call count (never altered by a later correction).
  submittedCallCount            Int
  scoreableCallCount            Int
  neutralizedCallCount          Int
  /// Calls on players invalidated before lock (C2), whether scored as misses or neutralized by precedence.
  invalidatedCallCount          Int
  exactCallCount                Int
  /// min(maxCalls, eligible pool of the contest's pinned snapshot); 0 for a zero-field contest.
  availableSlots                Int
  /// max(availableSlots - neutralized calls, 0).
  effectiveAvailableSlots       Int
  /// k in the coverage modifier: min(scoreable calls, effective available slots), so coverage never exceeds 100%.
  coverageCallCount             Int
  /// The original submission has more calls than the corrected pool's available slots (pre-lock snapshot correction).
  slotOverflow                  Boolean
  earnedRawPoints               Int
  maxRawPoints                  Int
  coverageModifierNumerator     Int?
  coverageModifierDenominator   Int?
  eyeqHundredths                Int?
  totalFpHundredths             Int
  fpPerCallHundredths           Int?
  fpPerCallDenominator          Int
  fpPerAvailableSlotHundredths  Int?
  fpPerAvailableSlotDenominator Int
  resultKind                    WaiverBoardResultKind
  /// Set exactly when resultKind = NA_NO_EFFECTIVE_SLOTS.
  ungradableReason              WaiverUngradableReason?
  played                        Boolean
  honorEligible                 Boolean
  honorIneligibleReason         String?
  awardedHonor                  WaiverHonor?
  inputFingerprint              String
  outputFingerprint             String

  gradeRun       WaiverGradeRun             @relation(fields: [gradeRunId], references: [id], onDelete: Restrict)
  contest        WaiverContest              @relation(fields: [contestId], references: [id], onDelete: Restrict)
  contestResult  WaiverContestResult        @relation(fields: [contestResultId], references: [id], onDelete: Restrict)
  submission     WaiverSubmission           @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  revision       WaiverSubmissionRevision   @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  callGrades     WaiverCallGrade[]
  authorities    WaiverBoardGradeAuthority[]

  @@unique([gradeRunId, submissionId])
  @@index([submissionId])
  @@index([contestId])
  @@index([contestResultId])
  @@index([revisionId])
}

/// Immutable result of one call. `exact` is the per-call EXACT label.
model WaiverCallGrade {
  id                       String                          @id @default(cuid())
  boardGradeId             String
  callId                   String
  slot                     Int
  snapshotEntryId          String
  rankableEntryId          String
  poolResultId             String
  treatment                WaiverResultTreatment
  scored                   Boolean
  waiverPoolRank           Int?
  canonicalPositionRank    Int?
  fpHundredths             Int?
  inResultField            Boolean
  exact                    Boolean
  earnedRawPoints          Int?
  maxRawPoints             Int?
  honorCreditEligible      Boolean
  invalidatedPreLock       Boolean
  neutralizationPrecedence WaiverNeutralizationPrecedence?
  conflictResolutionId     String?
  inputFingerprint         String
  outputFingerprint        String

  boardGrade WaiverBoardGrade @relation(fields: [boardGradeId], references: [id], onDelete: Restrict)
  call       WaiverCall       @relation(fields: [callId], references: [id], onDelete: Restrict)
  poolResult WaiverPoolResult @relation(fields: [poolResultId], references: [id], onDelete: Restrict)

  @@unique([boardGradeId, slot])
  @@unique([boardGradeId, callId])
  @@index([callId])
  @@index([poolResultId])
}

/// Immutable, explicit approval to use one grade run competitively, bound to
/// its exact artifact revision, snapshots, resolution set and output. Never
/// implied by the artifact import attestation.
model WaiverGradeApproval {
  id                        String                    @id @default(cuid())
  weekId                    String
  gradeRunId                String
  artifactRowId             String
  artifactRevision          Int
  artifactContentChecksum   String
  snapshotSetFingerprint    String
  resolutionSetFingerprint  String
  inputFingerprint          String
  outputFingerprint         String
  defCrosswalkVersion       String
  defCrosswalkAcknowledged  Boolean
  approvalPolicy            WaiverGradeApprovalPolicy
  approvedByUserId          String
  /// Evidence copies (database-verified) for separation-of-duties checks.
  artifactImportedByUserId  String
  gradeRunInitiatedByUserId String?
  attestationVersion        String
  attestationText           String
  reason                    String
  /// Database clock (`waiver_utc_now()`), set by the insert trigger.
  approvedAt                DateTime                  @default(now())

  week       Week                        @relation(fields: [weekId], references: [id], onDelete: Restrict)
  gradeRun   WaiverGradeRun              @relation(fields: [gradeRunId], references: [id], onDelete: Restrict)
  artifact   WaiverCanonicalArtifact     @relation(fields: [artifactRowId], references: [id], onDelete: Restrict)
  approvedBy User                        @relation("WaiverGradeApprovalApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  change     WaiverGradeAuthorityChange?

  @@unique([gradeRunId, approvedByUserId])
  @@index([weekId])
  @@index([artifactRowId])
  @@index([approvedByUserId])
}

/// Append-only history of week grading authority decisions.
model WaiverGradeAuthorityChange {
  id                String                         @id @default(cuid())
  weekId            String
  /// Contiguous per week, from 1.
  sequence          Int
  changeType        WaiverGradeAuthorityChangeType
  priorChangeId     String?                        @unique
  priorGradeRunId   String?
  newGradeRunId     String
  approvalId        String                         @unique
  /// Evidence copy of the approval's approving admin (database-verified).
  approvedByUserId  String
  reason            String
  inputFingerprint  String
  outputFingerprint String
  /// Database clock (`waiver_utc_now()`), set by the insert trigger.
  recordedAt        DateTime                       @default(now())

  week               Week                           @relation(fields: [weekId], references: [id], onDelete: Restrict)
  priorChange        WaiverGradeAuthorityChange?    @relation("WaiverGradeAuthorityChangeChain", fields: [priorChangeId], references: [id], onDelete: Restrict)
  nextChange         WaiverGradeAuthorityChange?    @relation("WaiverGradeAuthorityChangeChain")
  priorGradeRun      WaiverGradeRun?                @relation("WaiverGradeAuthorityChangePriorRun", fields: [priorGradeRunId], references: [id], onDelete: Restrict)
  newGradeRun        WaiverGradeRun                 @relation("WaiverGradeAuthorityChangeNewRun", fields: [newGradeRunId], references: [id], onDelete: Restrict)
  approval           WaiverGradeApproval            @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  weekAuthority      WaiverWeekGradeAuthority?
  contestAuthorities WaiverContestResultAuthority[]
  boardAuthorities   WaiverBoardGradeAuthority[]

  @@unique([weekId, sequence])
  @@index([priorGradeRunId])
  @@index([newGradeRunId])
}

/// The week-atomic authority boundary: the one grade run currently
/// authoritative for a week. Contest and board pointers must agree with it
/// at COMMIT.
model WaiverWeekGradeAuthority {
  weekId            String   @id
  gradeRunId        String
  changeId          String   @unique
  outputFingerprint String
  /// Database clock (`waiver_utc_now()`), set by the write trigger.
  updatedAt         DateTime @default(now())

  week     Week                       @relation(fields: [weekId], references: [id], onDelete: Restrict)
  gradeRun WaiverGradeRun             @relation(fields: [gradeRunId], references: [id], onDelete: Restrict)
  change   WaiverGradeAuthorityChange @relation(fields: [changeId], references: [id], onDelete: Restrict)

  @@index([gradeRunId])
}

/// Current authoritative result for one contest (moves only with the week).
model WaiverContestResultAuthority {
  contestId       String   @id
  weekId          String
  contestResultId String
  artifactRowId   String
  gradeRunId      String
  changeId        String
  /// Database clock (`waiver_utc_now()`), set by the write trigger.
  updatedAt       DateTime @default(now())

  contest       WaiverContest              @relation(fields: [contestId], references: [id], onDelete: Restrict)
  contestResult WaiverContestResult        @relation(fields: [contestResultId], references: [id], onDelete: Restrict)
  gradeRun      WaiverGradeRun             @relation(fields: [gradeRunId], references: [id], onDelete: Restrict)
  change        WaiverGradeAuthorityChange @relation(fields: [changeId], references: [id], onDelete: Restrict)

  @@index([weekId])
  @@index([contestResultId])
  @@index([gradeRunId])
  @@index([changeId])
}

/// Current authoritative grade for one submitted board (moves only with the week).
model WaiverBoardGradeAuthority {
  submissionId String   @id
  weekId       String
  contestId    String
  boardGradeId String
  gradeRunId   String
  changeId     String
  /// Database clock (`waiver_utc_now()`), set by the write trigger.
  updatedAt    DateTime @default(now())

  submission WaiverSubmission           @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  boardGrade WaiverBoardGrade           @relation(fields: [boardGradeId], references: [id], onDelete: Restrict)
  gradeRun   WaiverGradeRun             @relation(fields: [gradeRunId], references: [id], onDelete: Restrict)
  change     WaiverGradeAuthorityChange @relation(fields: [changeId], references: [id], onDelete: Restrict)

  @@index([weekId])
  @@index([boardGradeId])
  @@index([gradeRunId])
  @@index([changeId])
}

// ---------------------------------------------------------------------------
// RankEyeQ Waivers — AI participation (Stage 4B.3A).
// SYSTEM_OPERATED AI boards keep the verbatim AI response behind every
// revision (WaiverAiResponse). Historical AI predictions recorded outside the
// competitive window are record-only evidence: never a board, call, grade,
// consensus or leaderboard input. Docs: docs/waivers-ai-participation.md.
// ---------------------------------------------------------------------------

/// Immutable verbatim AI response behind one SYSTEM_OPERATED SUBMISSION revision.
model WaiverAiResponse {
  id                 String          @id @default(cuid())
  revisionId         String          @unique
  contestId          String
  position           ContestPosition
  /// The contest's pinned frozen snapshot the prompt was built from and the response parsed against.
  snapshotId         String
  universalProfileId String
  /// Admin-entered model label (e.g. the model version the response came from).
  modelLabel         String
  promptVersion      String
  /// sha256 of the exact prompt text (deterministic for the pinned snapshot and position).
  promptSha256       String
  parserVersion      String
  /// Exact response text as received by the server; never trimmed or normalized.
  responseText       String
  /// sha256 of the UTF-8 response text (database-checked).
  responseSha256     String
  responseByteLength Int
  /// Explicit NO CALLS response (zero-call board).
  noCalls            Boolean
  /// Generation time as stated by the importing admin. Unverified; never proof of timing.
  statedGeneratedAt  DateTime?
  sourceReference    String?
  sourceNote         String?
  importedByUserId   String
  /// Database clock (`waiver_utc_now()`), set by the insert trigger.
  importedAt         DateTime        @default(now())

  revision         WaiverSubmissionRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  contest          WaiverContest            @relation(fields: [contestId], references: [id], onDelete: Restrict)
  snapshot         WaiverSnapshot           @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  universalProfile UniversalProfile         @relation(fields: [universalProfileId], references: [id], onDelete: Restrict)
  importedBy       User                     @relation("WaiverAiResponseImportedBy", fields: [importedByUserId], references: [id], onDelete: Restrict)

  @@index([contestId, universalProfileId])
  @@index([snapshotId])
  @@index([universalProfileId])
  @@index([importedByUserId])
}

/// Append-only record of a historical AI prediction. Record-only: never creates or
/// affects a Waiver board, revision, call, grade, approval, consensus or leaderboard.
model WaiverAiHistoricalEvidence {
  id                 String          @id @default(cuid())
  contestId          String
  position           ContestPosition
  /// The contest's pinned frozen snapshot when recorded.
  snapshotId         String
  universalProfileId String
  modelLabel         String
  /// Exact original response text as received by the server.
  responseText       String
  /// sha256 of the UTF-8 response text (database-checked).
  responseSha256     String
  responseByteLength Int
  /// Original source time as stated by the recording admin. Unverified; never proof.
  statedSourceAt     DateTime?
  /// Kind of preserved evidence (e.g. CHAT_EXPORT, SCREENSHOT_TRANSCRIPTION).
  evidenceSource     String
  evidenceReference  String
  note               String?
  /// Database-derived: recordedAt is at or after the contest's lock.
  recordedAfterLock  Boolean
  recordedByUserId   String
  /// Database clock (`waiver_utc_now()`), set by the insert trigger.
  recordedAt         DateTime        @default(now())

  contest          WaiverContest                      @relation(fields: [contestId], references: [id], onDelete: Restrict)
  snapshot         WaiverSnapshot                     @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  universalProfile UniversalProfile                   @relation(fields: [universalProfileId], references: [id], onDelete: Restrict)
  recordedBy       User                               @relation("WaiverAiHistoricalEvidenceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  reviews          WaiverAiHistoricalEvidenceReview[]

  @@unique([contestId, universalProfileId, responseSha256])
  @@index([universalProfileId])
  @@index([snapshotId])
  @@index([recordedByUserId])
}

/// Review outcome of historical evidence. None implies competitive eligibility.
enum WaiverAiEvidenceReviewStatus {
  /// The stored text was checked against the preserved original.
  TEXT_CONFIRMED
  NEEDS_FOLLOW_UP
  REJECTED
}

/// Append-only review history; the latest sequence is the current review status.
model WaiverAiHistoricalEvidenceReview {
  id             String                       @id @default(cuid())
  evidenceId     String
  sequence       Int
  status         WaiverAiEvidenceReviewStatus
  note           String
  reviewerUserId String
  /// Database clock (`waiver_utc_now()`), set by the insert trigger.
  reviewedAt     DateTime                     @default(now())

  evidence WaiverAiHistoricalEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  reviewer User                       @relation("WaiverAiHistoricalEvidenceReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@unique([evidenceId, sequence])
  @@index([reviewerUserId])
}
